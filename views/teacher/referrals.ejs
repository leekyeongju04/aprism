<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">Student Intervention & Guidance Referrals</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Track attendance interventions, academic deficiencies, and disciplinary cases for STI College Dasmariñas.</p>
      </div>
      <div>
        <button class="btn btn-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newReferralModal">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>File Referral</span>
        </button>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Active Case Referrals</h5>
        <span class="badge bg-danger"><%= referrals.length %> cases</span>
      </div>
      <div class="card-body p-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Case Ref</th>
                <th>Student</th>
                <th>Section & Subject</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Observations</th>
                <th>Date Filed</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% referrals.forEach(ref => { %>
                <tr>
                  <td class="font-monospace fw-bold">#REF-00<%= ref.id %></td>
                  <td>
                    <div class="fw-bold"><%= ref.studentName %></div>
                    <small class="font-monospace text-muted"><%= ref.studentNumber %></small>
                  </td>
                  <td><%= ref.section %> • <%= ref.subject %></td>
                  <td><span class="badge bg-light text-dark border"><%= ref.reason %></span></td>
                  <td>
                    <span class="badge <%= ref.urgency === 'High' ? 'bg-danger' : 'bg-warning text-dark' %>"><%= ref.urgency %></span>
                  </td>
                  <td style="max-width: 250px; font-size: 13px;"><%= ref.description %></td>
                  <td class="text-muted small"><%= ref.dateFiled %></td>
                  <td>
                    <span class="badge <%= ref.status === 'Pending' ? 'bg-warning text-dark' : (ref.status === 'Closed' ? 'bg-success' : 'bg-info text-dark') %>">
                      <%= ref.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <form action="/actions/teacher/update_referral_status" method="POST" class="d-inline">
                      <input type="hidden" name="referral_id" value="<%= ref.id %>">
                      <% if (ref.status === 'Pending') { %>
                        <button type="submit" name="status" value="Under Review" class="btn btn-sm btn-outline-info">Review</button>
                      <% } else if (ref.status === 'Under Review') { %>
                        <button type="submit" name="status" value="Closed" class="btn btn-sm btn-outline-success">Close Case</button>
                      <% } else { %>
                        <span class="badge bg-secondary">Archived</span>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- New Referral Modal -->
    <div class="modal fade" id="newReferralModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
          <form action="/actions/teacher/create_referral" method="POST">
            <input type="hidden" name="class_id" value="1">
            <div class="modal-header border-0 pb-0">
              <h5 class="modal-title fw-bold text-danger">New Student Referral</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
              <div class="mb-3">
                <label class="form-label small fw-bold">Student</label>
                <select name="student_id" class="form-select" required>
                  <% students.forEach(s => { %>
                    <option value="<%= s.id %>"><%= s.lastName %>, <%= s.firstName %> (<%= s.studentNumber %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Reason / Category</label>
                <select name="reason" class="form-select" required>
                  <option value="Chronic Absenteeism">Chronic Absenteeism</option>
                  <option value="Academic Deficiency">Academic Deficiency</option>
                  <option value="Behavioral / Disciplinary">Behavioral / Disciplinary</option>
                  <option value="Special Guidance">Special Guidance</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Urgency</label>
                <select name="urgency" class="form-select">
                  <option value="High">High</option>
                  <option value="Medium" selected>Medium</option>
                  <option value="Low">Low</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Details</label>
                <textarea name="description" class="form-control" rows="3" required placeholder="Describe circumstances..."></textarea>
              </div>
            </div>
            <div class="modal-footer border-0 pt-0">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">File Case</button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
