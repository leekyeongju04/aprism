<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">Database Backup & Recovery</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Manage automated snapshots, historical SQL archives, and database retention rules.</p>
      </div>
      <div>
        <form action="/actions/system/create_backup" method="POST" class="d-inline">
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
            <i data-lucide="database" class="w-4 h-4"></i>
            <span>Create Snapshot</span>
          </button>
        </form>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <div class="row g-4 mb-4">
      <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Historical Backup Files</h5>
            <span class="badge bg-secondary"><%= backups.length %> archives</span>
          </div>
          <div class="card-body p-4">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Filename</th>
                    <th>Archive Type</th>
                    <th>File Size</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% backups.forEach(b => { %>
                    <tr>
                      <td class="font-monospace fw-semibold" style="font-size: 13px;"><%= b.filename %></td>
                      <td><span class="badge bg-light text-dark border">Full SQL</span></td>
                      <td class="text-muted" style="font-size: 13px;"><%= b.size %></td>
                      <td style="font-size: 13px;"><%= b.createdAt %></td>
                      <td class="text-end">
                        <a href="/actions/system/download_backup?file=<%= encodeURIComponent(b.filename) %>" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                          <i data-lucide="download" class="w-4 h-4"></i>
                          <span>Download</span>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold mb-0">Retention & Schedule</h5>
          </div>
          <div class="card-body p-4">
            <form action="/actions/system/update_backup_settings" method="POST">
              <div class="mb-3">
                <label class="form-label small fw-bold">Automated Schedule</label>
                <select class="form-select" name="backup_schedule">
                  <option value="daily" selected>Daily at Midnight (00:00)</option>
                  <option value="weekly">Weekly on Sunday</option>
                  <option value="disabled">Disabled</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Retention Period (Days)</label>
                <input type="number" name="retention_days" class="form-control" value="30" min="7" max="365">
                <div class="form-text">Backups older than this will be pruned automatically.</div>
              </div>
              <button type="submit" class="btn btn-outline-primary btn-sm w-100">Save Configuration</button>
            </form>
          </div>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
