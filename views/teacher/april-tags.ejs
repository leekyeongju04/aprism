<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">AprilTag Allocation & Management</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Manage optical fiducial markers (Family 36h11), student tag cards, and distribution.</p>
      </div>
      <div>
        <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" onclick="window.print();">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Print Tag Sheet</span>
        </button>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <!-- AprilTags Visual Grid -->
    <div class="row g-4 mb-4">
      <% students.forEach(s => { %>
        <div class="col-12 col-sm-6 col-md-4 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 h-100 p-3 text-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge bg-dark font-monospace">Tag #<%= s.aprilTagId %></span>
              <span class="badge bg-success bg-opacity-10 text-success border border-success">Assigned</span>
            </div>

            <!-- Optical Marker Visual -->
            <div class="p-3 bg-white border rounded-3 my-2 d-inline-flex justify-content-center shadow-sm">
              <svg width="100" height="100" viewBox="0 0 10 10" style="image-rendering: pixelated; shape-rendering: crispEdges;">
                <rect width="10" height="10" fill="#000" />
                <rect x="2" y="2" width="6" height="6" fill="#fff" />
                <!-- Deterministic pattern based on tag ID -->
                <rect x="<%= 3 + (s.aprilTagId % 3) %>" y="3" width="1" height="1" fill="#000" />
                <rect x="4" y="<%= 3 + ((s.aprilTagId + 1) % 3) %>" width="2" height="1" fill="#000" />
                <rect x="<%= 3 + ((s.aprilTagId * 2) % 4) %>" y="5" width="2" height="2" fill="#000" />
                <rect x="6" y="6" width="1" height="1" fill="#000" />
              </svg>
            </div>

            <h6 class="fw-bold mb-0 text-truncate" title="<%= s.lastName %>, <%= s.firstName %>"><%= s.lastName %>, <%= s.firstName %></h6>
            <div class="font-monospace text-muted small mb-2"><%= s.studentNumber %></div>
            <div class="text-muted small">BSIT-401 • IT405</div>

            <form action="/actions/teacher/manage_april_tag" method="POST" class="mt-3">
              <input type="hidden" name="student_id" value="<%= s.id %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Reassign Tag</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
