<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">Teacher Dashboard</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Welcome back, <%= user.firstName %> <%= user.lastName %>! Active Term: <%= currentSchoolYear %> Prelim.</p>
      </div>
      <div>
        <a href="/dashboard/teacher_attendance" class="btn btn-primary d-flex align-items-center gap-2">
          <i data-lucide="scan" class="w-4 h-4"></i>
          <span>Launch AprilTag Attendance</span>
        </a>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <!-- Teacher Dashboard Stats -->
    <section class="teacher-dashboard-stats mb-4">
      <article class="teacher-stat-card">
        <div class="teacher-stat-icon teacher-stat-icon-blue">
          <i data-lucide="calendar-days"></i>
        </div>
        <span class="teacher-stat-label">Today's Classes</span>
        <h2 class="teacher-stat-value"><%= operationalClasses.length %></h2>
      </article>

      <article class="teacher-stat-card">
        <div class="teacher-stat-icon teacher-stat-icon-green">
          <i data-lucide="file-up"></i>
        </div>
        <span class="teacher-stat-label">Pending Grade Imports</span>
        <h2 class="teacher-stat-value">1</h2>
      </article>

      <article class="teacher-stat-card">
        <div class="teacher-stat-icon teacher-stat-icon-orange">
          <i data-lucide="triangle-alert"></i>
        </div>
        <span class="teacher-stat-label">Flagged Students</span>
        <h2 class="teacher-stat-value"><%= students.filter(s => s.attendanceRate < 80).length %></h2>
      </article>

      <article class="teacher-stat-card">
        <div class="teacher-stat-icon teacher-stat-icon-purple">
          <i data-lucide="clipboard-check"></i>
        </div>
        <span class="teacher-stat-label">Attendance Today</span>
        <h2 class="teacher-stat-value">87.5%</h2>
      </article>
    </section>

    <!-- Today's Classes Timetable & Action Cards -->
    <div class="row g-4 mb-4">
      <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Assigned Operational Classes</h5>
            <span class="badge bg-primary">A.Y. <%= currentSchoolYear %></span>
          </div>
          <div class="card-body p-4">
            <div class="d-flex flex-column gap-3">
              <% operationalClasses.forEach(c => { %>
                <div class="p-3 border rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 bg-light">
                  <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <span class="badge bg-primary font-monospace"><%= c.subjectCode %></span>
                      <h6 class="fw-bold mb-0"><%= c.subjectName %></h6>
                    </div>
                    <div class="text-muted small">
                      <span class="fw-semibold text-dark"><%= c.section %></span> • 
                      <span><%= c.schedule %></span> • 
                      <span class="badge bg-light text-secondary border"><%= c.room %></span>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <a href="/dashboard/teacher_my_class?class_id=<%= c.id %>" class="btn btn-sm btn-outline-secondary">Roster & Grades</a>
                    <a href="/dashboard/teacher_attendance?class_id=<%= c.id %>" class="btn btn-sm btn-primary d-flex align-items-center gap-1">
                      <i data-lucide="camera" class="w-4 h-4"></i>
                      <span>Take Attendance</span>
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions and Alerts -->
      <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold mb-0">Teacher Quick Actions</h5>
          </div>
          <div class="card-body p-4 d-grid gap-2">
            <a href="/dashboard/teacher_my_class" class="btn btn-outline-primary text-start d-flex align-items-center gap-2">
              <i data-lucide="book-open" class="w-4 h-4"></i>
              <span>My Classes & Roster</span>
            </a>
            <a href="/dashboard/teacher_attendance" class="btn btn-outline-primary text-start d-flex align-items-center gap-2">
              <i data-lucide="users" class="w-4 h-4"></i>
              <span>AprilTag Attendance Session</span>
            </a>
            <a href="/dashboard/teacher_april_tags" class="btn btn-outline-primary text-start d-flex align-items-center gap-2">
              <i data-lucide="tag" class="w-4 h-4"></i>
              <span>Manage AprilTags</span>
            </a>
            <a href="/dashboard/teacher_referrals" class="btn btn-outline-danger text-start d-flex align-items-center gap-2">
              <i data-lucide="triangle-alert" class="w-4 h-4"></i>
              <span>File Student Referral</span>
            </a>
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Recent Alerts</h5>
            <span class="badge bg-warning text-dark"><%= referrals.length %></span>
          </div>
          <div class="card-body p-4">
            <% referrals.forEach(ref => { %>
              <div class="p-2 border rounded-3 mb-2 bg-light">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold small"><%= ref.studentName %></span>
                  <span class="badge bg-danger" style="font-size: 10px;"><%= ref.urgency %></span>
                </div>
                <div class="text-muted" style="font-size: 11px;"><%= ref.reason %></div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
