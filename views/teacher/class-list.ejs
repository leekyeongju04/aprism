<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">Class List Import & Resolution</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Import official class rosters from Excel/CSV and reconcile against the institutional student registry.</p>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <div class="row g-4 mb-4">
      <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i data-lucide="file-up" class="w-5 h-5 text-primary"></i>
            <span>Upload Roster Spreadsheet</span>
          </h5>
          <p class="text-muted small">Upload `.xlsx` or `.csv` export from the STI institutional registry.</p>

          <form action="/actions/teacher/import_class_list" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label small fw-bold">Target Operational Class</label>
              <select name="class_id" class="form-select">
                <% operationalClasses.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.subjectCode %> - <%= c.section %></option>
                <% }) %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold">Class List File (.xlsx / .csv)</label>
              <input type="file" name="class_file" class="form-control" accept=".xlsx,.xls,.csv">
            </div>

            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
              <i data-lucide="upload" class="w-4 h-4"></i>
              <span>Process & Reconcile Roster</span>
            </button>
          </form>

          <hr class="my-4">
          <div class="small text-muted">
            <h6 class="fw-bold small mb-1">Automatic Resolution Features:</h6>
            <ul class="ps-3 mb-0">
              <li>Matches student numbers against institutional registry</li>
              <li>Auto-assigns available AprilTag identifiers</li>
              <li>Preserves existing enrollment records</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Reconciled Students (IT405 - BSIT-401)</h5>
            <span class="badge bg-success"><%= students.length %> Matched</span>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Student Number</th>
                  <th>Name</th>
                  <th>Institutional Match</th>
                  <th>Assigned Tag</th>
                </tr>
              </thead>
              <tbody>
                <% students.forEach(s => { %>
                  <tr>
                    <td class="font-monospace text-secondary" style="font-size: 13px;"><%= s.studentNumber %></td>
                    <td class="fw-semibold"><%= s.lastName %>, <%= s.firstName %></td>
                    <td>
                      <span class="badge bg-success bg-opacity-10 text-success border border-success">
                        <i data-lucide="check" class="w-3 h-3 inline-block"></i> Verified
                      </span>
                    </td>
                    <td><span class="badge bg-dark font-monospace">Tag #<%= s.aprilTagId %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
