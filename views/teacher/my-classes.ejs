<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">My Operational Classes</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Class roster, AprilTag assignments, attendance performance, and student intervention tracking.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/dashboard/teacher_attendance?class_id=<%= selectedClass.id %>" class="btn btn-primary d-flex align-items-center gap-2">
          <i data-lucide="camera" class="w-4 h-4"></i>
          <span>Live Attendance</span>
        </a>
        <button class="btn btn-outline-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createReferralModal">
          <i data-lucide="triangle-alert" class="w-4 h-4"></i>
          <span>File Referral</span>
        </button>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <!-- Class Selector Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2">
          <% operationalClasses.forEach(c => { %>
            <a href="/dashboard/teacher_my_class?class_id=<%= c.id %>" class="btn <%= c.id === selectedClass.id ? 'btn-primary' : 'btn-light border' %> px-3 py-2 text-start">
              <div class="fw-bold font-monospace"><%= c.subjectCode %></div>
              <small class="<%= c.id === selectedClass.id ? 'text-white-50' : 'text-muted' %>"><%= c.section %></small>
            </a>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Active Class Details Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <div class="badge bg-warning text-dark mb-2 font-monospace fs-6"><%= selectedClass.subjectCode %></div>
          <h3 class="fw-bold mb-1"><%= selectedClass.subjectName %></h3>
          <p class="mb-0 text-white-50">
            Section: <strong><%= selectedClass.section %></strong> • Room: <strong><%= selectedClass.room %></strong> • Schedule: <strong><%= selectedClass.schedule %></strong>
          </p>
        </div>
        <div class="d-flex gap-3 text-center">
          <div class="bg-white bg-opacity-10 p-3 rounded-3">
            <div class="fs-4 fw-bold"><%= students.length %></div>
            <small class="text-white-50">Enrolled</small>
          </div>
          <div class="bg-white bg-opacity-10 p-3 rounded-3">
            <div class="fs-4 fw-bold">87.5%</div>
            <small class="text-white-50">Avg Attendance</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Student Roster Table -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Class Roster & Student Monitoring</h5>
        <span class="badge bg-secondary"><%= students.length %> Enrolled</span>
      </div>
      <div class="card-body p-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Student Number</th>
                <th>Student Name</th>
                <th>AprilTag ID</th>
                <th>Attendance %</th>
                <th>Prelim Grade</th>
                <th>Intervention Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td class="font-monospace text-secondary" style="font-size: 13px;"><%= s.studentNumber %></td>
                  <td class="fw-bold"><%= s.lastName %>, <%= s.firstName %></td>
                  <td>
                    <span class="badge bg-dark font-monospace py-1 px-2">Tag #<%= s.aprilTagId %></span>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1" style="width: 70px; height: 6px;">
                        <div class="progress-bar <%= s.attendanceRate >= 80 ? 'bg-success' : (s.attendanceRate >= 70 ? 'bg-warning' : 'bg-danger') %>" style="width: <%= s.attendanceRate %>%"></div>
                      </div>
                      <span class="small fw-semibold"><%= s.attendanceRate %>%</span>
                    </div>
                  </td>
                  <td>
                    <span class="fw-semibold <%= s.prelimGrade >= 75 ? 'text-success' : 'text-danger' %>"><%= s.prelimGrade %></span>
                    <small class="text-muted">/ 100</small>
                  </td>
                  <td>
                    <% if (s.status.includes('Critical')) { %>
                      <span class="badge bg-danger"><%= s.status %></span>
                    <% } else if (s.status.includes('At Risk') || s.status.includes('Warning')) { %>
                      <span class="badge bg-warning text-dark"><%= s.status %></span>
                    <% } else { %>
                      <span class="badge bg-success bg-opacity-10 text-success border border-success"><%= s.status %></span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <button class="btn btn-sm btn-outline-danger" onclick="openReferralModal('<%= s.id %>', '<%= s.lastName %>, <%= s.firstName %>', '<%= s.studentNumber %>')">
                      Refer
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Create Referral Modal -->
    <div class="modal fade" id="createReferralModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
          <form action="/actions/teacher/create_referral" method="POST">
            <input type="hidden" name="class_id" value="<%= selectedClass.id %>">
            <input type="hidden" name="student_id" id="refStudentId" value="<%= students[0]?.id %>">
            <div class="modal-header border-0 pb-0">
              <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                <i data-lucide="triangle-alert" class="w-5 h-5"></i>
                <span>File Intervention / Guidance Referral</span>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
              <div class="mb-3">
                <label class="form-label small fw-bold">Select Student</label>
                <select class="form-select" id="refStudentSelect" onchange="document.getElementById('refStudentId').value = this.value;">
                  <% students.forEach(s => { %>
                    <option value="<%= s.id %>"><%= s.lastName %>, <%= s.firstName %> (<%= s.studentNumber %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Referral Category</label>
                <select name="reason" class="form-select" required>
                  <option value="Chronic Absenteeism">Chronic Absenteeism (>3 consecutive absences)</option>
                  <option value="Academic Deficiency">Academic Deficiency (Failing Prelim assessment)</option>
                  <option value="Behavioral / Disciplinary">Behavioral / Disciplinary Infraction</option>
                  <option value="Special Assistance">Special Academic Guidance</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Urgency / Priority</label>
                <select name="urgency" class="form-select">
                  <option value="High">High (Immediate intervention required)</option>
                  <option value="Medium" selected>Medium (Standard follow-up)</option>
                  <option value="Low">Low (Observation)</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Observations & Notes</label>
                <textarea name="description" class="form-control" rows="3" required placeholder="Detail specific attendance absences, missed coursework, or observed factors..."></textarea>
              </div>
            </div>
            <div class="modal-footer border-0 pt-0">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">Submit Referral</button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>

  <script>
    function openReferralModal(studentId, studentName, studentNum) {
      document.getElementById('refStudentId').value = studentId;
      document.getElementById('refStudentSelect').value = studentId;
      new bootstrap.Modal(document.getElementById('createReferralModal')).show();
    }
  </script>
</body>
</html>
