<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content <%= typeof sidebarCollapsed !== 'undefined' && sidebarCollapsed ? 'expanded' : '' %>">
    <%- include('../partials/top-navbar') %>

    <section class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title mb-1">Academic Setup & Period Control</h1>
        <p class="text-muted mb-0" style="font-size: 14px;">Configure Academic Years, instructional terms, and student monitoring risk thresholds.</p>
      </div>
      <div>
        <button class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addSchoolYearModal">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Add School Year</span>
        </button>
      </div>
    </section>

    <%- include('../partials/flash-alert') %>

    <!-- School Years & Academic Periods Grid -->
    <div class="row g-4 mb-4">
      <!-- School Years Card -->
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Institutional School Years</h5>
            <span class="badge bg-primary">STI College Dasmariñas</span>
          </div>
          <div class="card-body p-4">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>School Year</th>
                    <th>Date Range</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% schoolYears.forEach(sy => { %>
                    <tr>
                      <td class="fw-bold"><%= sy.schoolYear %></td>
                      <td class="small text-muted"><%= sy.startDate %> to <%= sy.endDate %></td>
                      <td>
                        <span class="badge <%= sy.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                          <%= sy.status %>
                        </span>
                      </td>
                      <td class="text-end">
                        <% if (sy.status !== 'Active') { %>
                          <form action="/actions/academic_head/set_active_school_year" method="POST" class="d-inline">
                            <input type="hidden" name="school_year_id" value="<%= sy.id %>">
                            <button type="submit" class="btn btn-sm btn-outline-success">Set Active</button>
                          </form>
                        <% } else { %>
                          <span class="text-success small fw-semibold">Current Active</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Monitoring Thresholds Card -->
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold mb-1">Student Monitoring Thresholds</h5>
            <p class="text-muted small">Parameters used to identify at-risk students for intervention.</p>
          </div>
          <div class="card-body p-4">
            <form action="/actions/academic_head/update_thresholds" method="POST">
              <div class="mb-3">
                <label class="form-label small fw-bold">Attendance Warning Threshold (%)</label>
                <div class="input-group">
                  <input type="number" name="attendance_threshold" class="form-control" value="<%= monitoringThresholds.attendanceThreshold %>" min="50" max="100">
                  <span class="input-group-text">%</span>
                </div>
                <div class="form-text">Students falling below this percentage trigger early intervention alerts.</div>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-bold">Academic Grade Cutoff Threshold</label>
                <div class="input-group">
                  <input type="number" name="grade_threshold" class="form-control" value="<%= monitoringThresholds.gradeThreshold %>" min="50" max="100">
                  <span class="input-group-text">Passing Base</span>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-bold">Consecutive Unexcused Absences Alert</label>
                <input type="number" name="consecutive_absences" class="form-control" value="<%= monitoringThresholds.consecutiveAbsences %>" min="1" max="10">
              </div>

              <button type="submit" class="btn btn-outline-primary w-100">Update Monitoring Thresholds</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Academic Terms / Periods Table -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Instructional Terms for Active Academic Year (<%= currentSchoolYear %>)</h5>
      </div>
      <div class="card-body p-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Level</th>
                <th>Semester</th>
                <th>Instructional Term</th>
                <th>Term Schedule</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% academicPeriods.forEach(p => { %>
                <tr>
                  <td><%= p.level %></td>
                  <td><%= p.semester %></td>
                  <td class="fw-bold text-primary"><%= p.term %></td>
                  <td class="small text-muted"><%= p.startDate %> — <%= p.endDate %></td>
                  <td>
                    <span class="badge <%= p.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                      <%= p.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <% if (p.status !== 'Active') { %>
                      <form action="/actions/academic_head/set_active_term" method="POST" class="d-inline">
                        <input type="hidden" name="period_id" value="<%= p.id %>">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Activate Term</button>
                      </form>
                    <% } else { %>
                      <span class="badge bg-success bg-opacity-10 text-success">In Progress</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Add School Year Modal -->
    <div class="modal fade" id="addSchoolYearModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
          <form action="/actions/academic_head/create_school_year" method="POST">
            <div class="modal-header border-0 pb-0">
              <h5 class="modal-title fw-bold">Create School Year</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
              <div class="mb-3">
                <label class="form-label small fw-bold">School Year Label</label>
                <input type="text" name="school_year" class="form-control" placeholder="2028-2029" required>
              </div>
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label small fw-bold">Start Date</label>
                  <input type="date" name="start_date" class="form-control" required value="2028-08-10">
                </div>
                <div class="col-6">
                  <label class="form-label small fw-bold">End Date</label>
                  <input type="date" name="end_date" class="form-control" required value="2029-06-15">
                </div>
              </div>
            </div>
            <div class="modal-footer border-0 pt-0">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Create School Year</button>
            </div>
          </form>
        </div>
      </div>
    </div>

  </main>
  <%- include('../partials/logout-modal') %>
  <%- include('../partials/footer') %>
</body>
</html>
